#!/usr/bin/env python

Import("env")

# NVIDIA NGX SDK (DLSS Ray Reconstruction on Linux). SConstruct fetches the SDK into thirdparty/ngx;
# it is never committed. See README.md in this folder.

env.add_source_files(env.drivers_sources, "*.cpp")

env.Append(LIBPATH=["#thirdparty/ngx/lib/Linux_x86_64"])
env.Append(LIBS=["nvsdk_ngx"])
